# Google Gemini (either key name works)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-agent

# Same Postgres as this repo (pgvector-db / localhost:5433)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/travel_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=travel_agent
POSTGRES_PORT=5433
