# Google Gemini (either key name works) — used by app/ and multi_agent/
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Gemini model name: app/config/settings.py → GEMINI_MODEL

# Hugging Face — used by multi_agent_hf/
HF_TOKEN=
# HF model name: multi_agent_hf/llm.py → HF_MODEL

# LangSmith tracing (used by single-agent + multi-agent workflows)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-agent
# Optional aliases used by some SDKs
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-agent

# Same Postgres as this repo (pgvector-db / localhost:5433)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/travel_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=travel_agent
POSTGRES_PORT=5433
